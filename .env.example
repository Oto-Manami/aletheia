# 手元の開発用。実際の値は .env に書く（.env はリポジトリに入れない）
# Supabase CLI で手元に立ち上げたデータベース
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API（apps/api）
# Bot などが API を呼ぶときの鍵。32 文字以上の推測できない値を、各自で作って入れる
# （例: openssl rand -hex 32）。実際の値はパスワード管理アプリに保管する
API_SERVICE_TOKEN=
# 閲覧サイトのログインを確かめる公開鍵の場所（手元の Supabase）
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
PORT=8787
