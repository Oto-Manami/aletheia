# 手元の開発用。実際の値は .env に書く（.env はリポジトリに入れない）
# Supabase CLI で手元に立ち上げたデータベース
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API（apps/api）
# Bot などが API を呼ぶときの鍵。32 文字以上の推測できない値を、各自で作って入れる
# （例: openssl rand -hex 32）。実際の値はパスワード管理アプリに保管する
API_SERVICE_TOKEN=
# 閲覧サイトのログインを確かめる公開鍵の場所（手元の Supabase）
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
PORT=8787
# ブラウザから API を呼んでよい閲覧サイトの URL（カンマ区切り）。手元の閲覧サイトは Vite の既定のポート
VIEWER_ORIGINS=http://localhost:5173

# Discord Bot（apps/bot）
# Bot のトークン（Discord の開発者ポータルで発行。値はパスワード管理アプリに保管）
DISCORD_TOKEN=
API_URL=http://localhost:8787
# 承認カードを出すチャンネル・承認の記録を残すチャンネルの ID
REVIEW_CHANNEL_ID=
REVIEW_LOG_CHANNEL_ID=
# 承認できる運営者。「Discord の利用者 ID=閲覧サイトの利用者 ID」をカンマ区切りで
OPERATORS=
# 閲覧サイトの URL（任意。カードから編集画面へのリンクに使う）
VIEWER_URL=

# ファイルの保存先（apps/api）。local は手元のフォルダ（開発用）、drive は Google Drive
FILE_STORE=local
LOCAL_STORE_DIR=.files
# FILE_STORE=drive のとき: 専用アカウントの OAuth の設定と、アーカイブの最上位のフォルダの ID
# （値はパスワード管理アプリに保管する）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
